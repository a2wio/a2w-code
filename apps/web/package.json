{
  "name": "a2w-infra-agent-mvp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted infrastructure agent console for DevOps and platform engineers.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 5173",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 5173",
    "test": "node --test tests/*.test.js",
    "release:check": "sh ../../scripts/release-check.sh",
    "release:archive": "sh ../../scripts/package-release.sh",
    "sandbox:build": "podman build -t a2w-infra-sandbox:latest -f ../../sandbox/Containerfile ../../sandbox",
    "container:build": "podman build -t a2w-codex-terraform:0.0.1 -f ../../Dockerfile ../.."
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "next": "^16.2.4",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
