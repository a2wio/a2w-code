# Self-hosted admin login
A2W_ADMIN_USERNAME=admin
A2W_ADMIN_PASSWORD=change-me

# Instance identity shown in the UI and generated files
A2W_OPERATOR_NAME=Platform Operator
A2W_WORKSPACE_NAME=Local Platform
A2W_DEFAULT_CLOUD=azure

# Agent backend. The release image includes the Codex CLI.
A2W_AGENT_BACKEND=codex
# Optional instance default. The UI can override this per workspace.
# A2W_CODEX_MODEL=gpt-5.3-codex-spark
# A2W_CODEX_TIMEOUT_MS=180000

# Cookie signing and local credential encryption.
# Use different high-entropy values for real self-hosted deployments.
AUTH_SECRET=replace-with-a-long-random-string
A2W_ENCRYPTION_KEY=replace-with-a-different-long-random-string

# Keep disabled unless you intentionally want chat-approved Terraform apply/destroy.
A2W_ENABLE_TERRAFORM_APPLY=false

# Sandbox backend. Use podman for local development; use kubernetes when the
# app is deployed in-cluster with the RBAC from the Kubernetes manifests.
A2W_SANDBOX_BACKEND=podman

# Sandbox image used by Podman or by Kubernetes Jobs.
A2W_SANDBOX_IMAGE=a2w-infra-sandbox:latest

# Kubernetes sandbox settings. Required only with A2W_SANDBOX_BACKEND=kubernetes.
# A2W_K8S_NAMESPACE=a2w-codex-terraform
# A2W_K8S_DATA_PVC=a2w-codex-terraform-data
# A2W_K8S_SANDBOX_SERVICE_ACCOUNT=default

# Only needed when running the A2W web app in a container while the sandbox
# Podman engine runs on the host. The host path must point at this checkout.
# A2W_CONTAINER_PROJECT_ROOT=/app
# A2W_HOST_PROJECT_ROOT=/absolute/path/to/a2w/service
